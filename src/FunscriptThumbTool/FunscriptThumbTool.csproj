    <AssemblyName>FunscriptThumbTool</AssemblyName>
    <RootNamespace>FunscriptThumbTool</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
